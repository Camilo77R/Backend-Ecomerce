# ⚙️ TEMPLATE DE VARIABLES DE ENTORNO
# Copia este archivo a .env y completa con tus valores

# Puerto
PORT=3000

# 🔗 Supabase (Obtén en https://supabase.com)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-publica-aqui

# 🔐 JWT Secret (Genera uno nuevo)
# Comando para generar: openssl rand -hex 32
# O usa una herramienta online: https://generate-random.org/
JWT_SECRET=tu-secreto-super-seguro-aleatorio-aqui-minimo-32-caracteres
